[Unit]
Description=DTDisMind FastAPI Service
After=network.target

[Service]
Type=simple
User=admin1
Group=admin1
WorkingDirectory=/opt/dtdismind/app
Environment=DTD_DB_PATH=/opt/dtdismind/data/dtd_network.sqlite
ExecStart=/opt/conda/envs/dtd/bin/uvicorn app:app --host 0.0.0.0 --port 8099
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
